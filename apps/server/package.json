{
	"name": "server",
	"version": "1.0.0",
	"description": "This project was bootstrapped with Fastify-CLI.",
	"main": "dist/index.js",
	"directories": {
		"test": "test"
	},
	"scripts": {
		"build": "tsc && tsc-alias",
		"start": "node dist/index.js",
		"dev-js": "fastify start -w -l info -P dist/index.js",
		"dev": "bun --watch src/index.ts",
		"lint": "biome check --write",
		"update-deps": "pnpm update",
		"docker": "docker compose down && docker compose up -d",
		"spec": "vitest run --config src/test/vitest.config.ts",
		"test": "vitest run --config src/test/vitest.config.e2e.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@fastify/autoload": "^6.0.0",
		"@fastify/cors": "^11.4.3",
		"@fastify/sensible": "^6.0.0",
		"aedes": "^1.2.0",
		"fastify": "^5.0.0",
		"fastify-cli": "^7.4.1",
		"fastify-plugin": "^5.0.0",
		"fastify-type-provider-zod": "^7.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@repo/biome-config": "workspace:^",
		"@types/node": "^26.6.6",
		"tsc-alias": "^1.9.10",
		"unplugin-swc": "^2.0.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.1.1"
	}
}
